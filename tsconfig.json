{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["vite/client", "node", "vitest/globals"],
    "resolveJsonModule": true, "isolatedModules": true, "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "browser/**/*.ts", "*.config.ts"]
}
